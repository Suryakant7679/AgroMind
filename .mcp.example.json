{
  "mcpServers": {
    "supabase-readonly": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=YOUR_SUPABASE_PROJECT_REF&read_only=true"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\surya\\OneDrive\\Desktop\\AgroMind"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "C:\\Users\\surya\\OneDrive\\Desktop\\AgroMind"
      ]
    },
    "fetch": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    "memory": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "agromind-agriculture": {
      "command": "python",
      "args": [
        "-m",
        "agromind.mcp_servers.agriculture"
      ]
    },
    "agromind-health-evidence": {
      "command": "python",
      "args": [
        "-m",
        "agromind.mcp_servers.health"
      ]
    },
    "agromind-education": {
      "command": "python",
      "args": [
        "-m",
        "agromind.mcp_servers.education"
      ]
    }
  }
}
