# Copy to .env.docker and replace the three CHANGE_ME secrets.
AIOS_ENV_FILE=.env.docker
AIOS_IMAGE=agromind:local
POSTGRES_USER=agromind
POSTGRES_DB=agromind
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
AIOS_AUTH_REQUIRED=true
AIOS_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
AIOS_STORAGE_BACKEND=postgres
AIOS_VECTOR_BACKEND=chroma
AIOS_PROVIDER=auto
AGROMIND_DOCKER_PORT=18080
AI_TUTOR_DOCKER_PORT=18010
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
